# WebRTC normally requires the robot's Wi-Fi address. Leave blank for
# CycloneDDS over Ethernet.
ROBOT_IP=
CONN_TYPE=webrtc
WEBRTC_SERVER_PORT=9991

# Read-only Foxglove gateway. Keep loopback unless every tailnet device is an
# accepted viewer or an ACL limits this port. Then use the Jetson's Tailscale IP.
FOXGLOVE_ADDRESS=127.0.0.1
FOXGLOVE_PORT=8765
# Override this with an existing full-stack image on an offline Jetson.
FOXGLOVE_GATEWAY_IMAGE=go2-foxglove-gateway:humble

# Optional and intentionally disabled on Jetson by default.
INSTALL_COCO=false
INSTALL_CPP_LIDAR=false
INSTALL_FULL_STACK=false
APT_FORCE_IPV4=false
UBUNTU_PORTS_MIRROR=http://ports.ubuntu.com/ubuntu-ports
PIP_NO_INDEX=false
