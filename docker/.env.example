# WebRTC normally requires the robot's Wi-Fi address. Leave blank for
# CycloneDDS over Ethernet.
ROBOT_IP=
CONN_TYPE=webrtc
WEBRTC_SERVER_PORT=9991

# Optional and intentionally disabled on Jetson by default.
INSTALL_COCO=false
INSTALL_CPP_LIDAR=false
INSTALL_FULL_STACK=false
APT_FORCE_IPV4=false
UBUNTU_PORTS_MIRROR=http://ports.ubuntu.com/ubuntu-ports
PIP_NO_INDEX=false
